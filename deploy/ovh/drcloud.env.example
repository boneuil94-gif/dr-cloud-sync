DRCLOUD_ENV=production
DRCLOUD_SECRET_KEY=CHANGE_ME
DRCLOUD_ADMIN_USERNAME=CHANGE_ME
DRCLOUD_ADMIN_PASSWORD=CHANGE_ME
DRCLOUD_DATA_DIR=/data
DRCLOUD_BACKUP_DIR=/data/backups
DRCLOUD_ROADMAP=/app/docs/drcloud-os-roadmap.json
DRCLOUD_SAFE_MODE=true
DRCLOUD_TRUST_PROXY=true
BARCODE_SYNC_MODE=dry-run
HOST=0.0.0.0
PORT=8080

# Connecteurs facultatifs : laisser les placeholders tant qu'ils ne sont pas utilisés.
# Intégration optionnelle. Laisser les deux valeurs vides désactive l'import média.
PRESTASHOP_API_URL=https://dr-cloudshop.com/api
PRESTASHOP_API_KEY=
SHOPCAISSE_API_KEY=CHANGE_ME
SHOPCAISSE_COMPANY_ID=CHANGE_ME
SHOPCAISSE_SALES_INBOX=/data/shopcaisse-inbox
SHOPCAISSE_SYNC_INTERVAL_SECONDS=600
QONTO_CREDENTIAL_REF=QONTO_CREDENTIAL
QONTO_CREDENTIAL=
QONTO_TIMEOUT_SECONDS=8
DATA_HUB_BANK_INTERVAL_SECONDS=1800
DATA_HUB_SALES_INTERVAL_SECONDS=600
AUTOMATION_TICK_SECONDS=30
