# Copiez ce fichier vers .env ou exportez ces variables dans votre environnement.
# Ne commitez jamais .env ni la clé Webservice.
PRESTASHOP_API_URL=https://dr-cloudshop.com/api
PRESTASHOP_API_KEY=replace-with-a-read-only-webservice-key
# Obligatoire pour l'ingestion ventes : ids vérifiés des états réellement encaissés, séparés par des virgules.
PRESTASHOP_PAID_STATE_IDS=

# Facultatif
DR_CLOUD_SYNC_DB=./dr-cloud-sync.sqlite3
PRESTASHOP_TIMEOUT_SECONDS=30
PRESTASHOP_PAGE_SIZE=100

# DrCloud OS — fournir les secrets via le gestionnaire de secrets, jamais dans Git.
DRCLOUD_ENV=development
DRCLOUD_SECRET_KEY=replace-with-at-least-32-random-characters
DRCLOUD_ADMIN_USERNAME=admin
DRCLOUD_ADMIN_PASSWORD=replace-with-a-long-unique-password
DRCLOUD_DATA_DIR=.data
DRCLOUD_SAFE_MODE=true
DRCLOUD_TRUST_PROXY=false
HOST=0.0.0.0
PORT=8080
BARCODE_SYNC_MODE=dry-run
# Read-only Qonto Business API. The ref names the environment variable holding
# either the API-key login:secret pair or an OAuth Bearer token.
QONTO_CREDENTIAL_REF=QONTO_CREDENTIAL
QONTO_CREDENTIAL=
QONTO_TIMEOUT_SECONDS=8
DATA_HUB_BANK_INTERVAL_SECONDS=1800
SHOPCAISSE_SALES_INBOX=.data/shopcaisse-inbox
SHOPCAISSE_SYNC_INTERVAL_SECONDS=600
DATA_HUB_SALES_INTERVAL_SECONDS=600
AUTOMATION_TICK_SECONDS=30
